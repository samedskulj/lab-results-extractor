# Copy to .env. The AI assistant needs this key; without it the server says so and nothing can be analysed.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-5-5)
# AI_MODEL=claude-haiku-5-5
# Optional: AI responses to pasted text are cached in .llm-cache so repeats and evals replay instantly. Set to "off" to disable.
# LLM_CACHE=off

# Supabase project (Project Settings > API). Sign-in is email + password (Authentication > Providers > Email).
# The publishable key is safe in the browser; never put the secret/service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
