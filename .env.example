# Copy to .env and add your key to switch both apps from offline mode to Claude.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Optional: Claude responses are cached in .llm-cache so demos replay instantly. Set to "off" to disable.
# LLM_CACHE=off

# Supabase project (Project Settings > API). The publishable key is safe in the browser; never put the secret/service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
